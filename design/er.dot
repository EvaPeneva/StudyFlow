digraph ER {
  graph [rankdir=LR, bgcolor="#f7f8fc", pad="0.32", nodesep="0.65", ranksep="0.85", splines=polyline, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#9a8cd9", penwidth=1.8, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10, fontcolor="#5e5983"];
  profiles [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white" COLOR="#d9d4f0" STYLE="ROUNDED">
    <TR><TD BGCOLOR="#7055d7"><FONT COLOR="white"><B>PROFILES</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>PK / FK</B></FONT> id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT">display_name : TEXT</TD></TR><TR><TD ALIGN="LEFT">created_at : TIMESTAMPTZ</TD></TR>
  </TABLE> >];
  subjects [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white" COLOR="#d9d4f0">
    <TR><TD BGCOLOR="#7055d7"><FONT COLOR="white"><B>SUBJECTS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>PK</B></FONT> id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>FK</B></FONT> user_id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT">name : TEXT</TD></TR><TR><TD ALIGN="LEFT">color : TEXT</TD></TR>
  </TABLE> >];
  tasks [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white" COLOR="#d9d4f0">
    <TR><TD BGCOLOR="#494878"><FONT COLOR="white"><B>TASKS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>PK</B></FONT> id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>FK</B></FONT> user_id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>FK</B></FONT> subject_id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT">title : TEXT</TD></TR><TR><TD ALIGN="LEFT">due_date : DATE</TD></TR>
    <TR><TD ALIGN="LEFT">priority : SMALLINT</TD></TR><TR><TD ALIGN="LEFT">estimated_minutes : INT</TD></TR>
    <TR><TD ALIGN="LEFT">is_completed : BOOLEAN</TD></TR>
  </TABLE> >];
  reminders [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white" COLOR="#d9d4f0">
    <TR><TD BGCOLOR="#5a9d91"><FONT COLOR="white"><B>REMINDERS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>PK</B></FONT> id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>FK</B></FONT> user_id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>FK</B></FONT> task_id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT">remind_at : TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT">is_sent : BOOLEAN</TD></TR>
  </TABLE> >];
  task_tags [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="white" COLOR="#d9d4f0">
    <TR><TD BGCOLOR="#de9b7b"><FONT COLOR="white"><B>TASK_TAGS</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>PK</B></FONT> id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>FK</B></FONT> user_id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#7759cb"><B>FK</B></FONT> task_id : UUID</TD></TR>
    <TR><TD ALIGN="LEFT">label : TEXT</TD></TR>
  </TABLE> >];
  { rank=same; reminders; task_tags; }
  profiles -> subjects [label="1:N"];
  profiles -> tasks [label="1:N", constraint=false];
  subjects -> tasks [label="1:N"];
  tasks -> reminders [label="1:N"];
  tasks -> task_tags [label="1:N"];
}
